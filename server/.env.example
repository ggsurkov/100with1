PORT=5050
MONGO_URI=mongodb://localhost:27017/100with1
JWT_SECRET=changeme

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Base URL of the frontend, used to build the captain join link embedded in
# launch QR codes. Leave unset for local dev — it falls back to the request's
# own Origin/Referer (so LAN/ngrok testing works out of the box), then to
# http://localhost:5173.
# CLIENT_URL=https://your-ngrok-subdomain.ngrok-free.app

# Supabase ML service — RPC `create_game` generates the questions of a game.
# Both variables are mandatory. If one is missing, POST /api/games/generate
# answers 502 and the server logs a warning at start-up.
SUPABASE_ML_URL=https://your-project.supabase.co
SUPABASE_ML_KEY=

# Telegram bot for the captain Mini App (token from @BotFather).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Short name of the Mini App from @BotFather /newapp (direct link t.me/<bot>/<name>).
# TELEGRAM_APP_NAME=
